<?xml version="1.0" encoding="utf-8" ?>
<pages:BaseWindow
    x:Class="GameHelper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GameHelper"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GameHelper.Models"
    xmlns:pages="using:GameHelper.Pages"
    Title="Game Helper"
    mc:Ignorable="d">

    <pages:BaseWindow.SystemBackdrop>
        <MicaBackdrop />
    </pages:BaseWindow.SystemBackdrop>

    <NavigationView
        x:Name="nvMain"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        SelectionChanged="nvMain_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                Content="Games"
                Icon="AllApps"
                IsSelected="True"
                Tag="Games" />
        </NavigationView.MenuItems>

        <Grid Padding="16">
            <Grid x:Name="gamesPanel" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="8">
                    <StackPanel
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Games" />

                        <Button
                            Width="42"
                            Height="32"
                            VerticalAlignment="Center"
                            Command="{x:Bind VievModel.AddGameCommand}"
                            Content="+" />
                    </StackPanel>

                    <ListView ItemsSource="{x:Bind VievModel.Games}" SelectedItem="{x:Bind VievModel.SelectedGame, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Game">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        Width="100"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Name, Mode=OneWay}" />

                                    <Button
                                        Width="42"
                                        Height="32"
                                        HorizontalContentAlignment="Center"
                                        Click="DeleteGame_Click"
                                        Content="🗑" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="24,0,0,0"
                    HorizontalAlignment="Stretch"
                    Orientation="Vertical"
                    Spacing="8">
                    <StackPanel
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal"
                        Spacing="15">
                        <TextBox
                            Width="200"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            GotFocus="MacroField_GotFocus"
                            LostFocus="MacroField_LostFocus"
                            PlaceholderText="Game name"
                            Text="{x:Bind VievModel.SelectedGame.Name, Mode=TwoWay}" />

                        <ToggleSwitch
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            IsOn="{x:Bind VievModel.SelectedGame.isActive, Mode=TwoWay}" />

                        <Button
                            Width="42"
                            Height="32"
                            VerticalAlignment="Center"
                            Command="{x:Bind VievModel.AddMacroCommand}"
                            Content="+" />
                    </StackPanel>

                    <ListView ItemsSource="{x:Bind VievModel.SelectedGame.Macros, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Macro">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button
                                        Width="120"
                                        Command="{x:Bind KeyBind.RebindCommand}"
                                        Content="{x:Bind KeyBind.DisplayName, Mode=OneWay}" />

                                    <TextBox
                                        Width="160"
                                        GotFocus="MacroField_GotFocus"
                                        LostFocus="MacroField_LostFocus"
                                        PlaceholderText="Macro sequence"
                                        Text="{x:Bind Macros, Mode=TwoWay}" />

                                    <TextBox
                                        Width="160"
                                        GotFocus="MacroField_GotFocus"
                                        LostFocus="MacroField_LostFocus"
                                        PlaceholderText="Macro name"
                                        Text="{x:Bind Name, Mode=TwoWay}" />

                                    <Button
                                        Width="42"
                                        Height="32"
                                        Click="DeleteMacro_Click"
                                        Content="🗑" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Grid>

            <StackPanel
                x:Name="settingsPanel"
                Spacing="12"
                Visibility="Collapsed">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Settings" />

                <ToggleSwitch Header="Run on startup" IsOn="{x:Bind VievModel.RunOnStartup, Mode=TwoWay}" />

                <ToggleSwitch Header="Enable key hooks Global" IsOn="{x:Bind VievModel.KeyHooksEnabled, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
    </NavigationView>

</pages:BaseWindow>
