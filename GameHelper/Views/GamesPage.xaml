<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameHelper.Views.GamesPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GameHelper.Models"
    mc:Ignorable="d">

    <Grid Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="8">
            <StackPanel
                HorizontalAlignment="Stretch"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Games" />

                <Button
                    Width="42"
                    Height="32"
                    VerticalAlignment="Center"
                    Command="{Binding AddGameCommand}"
                    Content="+" />
            </StackPanel>

            <ListView ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Game">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Width="100"
                                VerticalAlignment="Center"
                                Text="{x:Bind Name, Mode=OneWay}" />

                            <Button
                                Width="42"
                                Height="32"
                                HorizontalContentAlignment="Center"
                                Command="{Binding ElementName=RootPage, Path=DataContext.DeleteGameCommand}"
                                CommandParameter="{x:Bind}"
                                Content="🗑" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Margin="24,0,0,0"
            HorizontalAlignment="Stretch"
            Orientation="Vertical"
            Spacing="8">
            <StackPanel
                HorizontalAlignment="Stretch"
                Orientation="Horizontal"
                Spacing="15">
                <TextBox
                    Width="200"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    GotFocus="MacroField_GotFocus"
                    LostFocus="MacroField_LostFocus"
                    PlaceholderText="Game name"
                    Text="{Binding SelectedGame.Name, Mode=TwoWay}" />

                <ToggleSwitch
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    IsOn="{Binding SelectedGame.IsActive, Mode=TwoWay}" />

                <Button
                    Width="42"
                    Height="32"
                    VerticalAlignment="Center"
                    Command="{Binding AddMacroCommand}"
                    Content="+" />
            </StackPanel>

            <ListView ItemsSource="{Binding SelectedGame.Macros}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Macro">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Width="120"
                                Command="{x:Bind KeyBind.RebindCommand}"
                                Content="{x:Bind KeyBind.DisplayName, Mode=OneWay}" />

                            <TextBox
                                Width="160"
                                GotFocus="MacroField_GotFocus"
                                LostFocus="MacroField_LostFocus"
                                PlaceholderText="Macro sequence"
                                Text="{x:Bind Sequence, Mode=TwoWay}" />

                            <TextBox
                                Width="160"
                                GotFocus="MacroField_GotFocus"
                                LostFocus="MacroField_LostFocus"
                                PlaceholderText="Macro name"
                                Text="{x:Bind Name, Mode=TwoWay}" />

                            <Button
                                Width="42"
                                Height="32"
                                Command="{Binding ElementName=RootPage, Path=DataContext.DeleteMacroCommand}"
                                CommandParameter="{x:Bind}"
                                Content="🗑" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
